{
  "routes": [
    { "route": "/api/status", "allowedRoles": ["anonymous"] },
    { "route": "/*", "allowedRoles": ["anonymous"] }
  ],
  "responseOverrides": {
    "401": { "statusCode": 302, "redirect": "/" }
  },
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/*.{css,js,png,jpg,jpeg,gif,svg,ico,json}"]
  }
}
